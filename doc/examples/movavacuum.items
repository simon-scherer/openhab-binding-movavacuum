// ---- Room selection helpers (used by movavacuum.rules, not linked to a channel) ----
// Name the switches Vacuum_Sel_<room number>; the numbers are shown in the "rooms" channel.
Switch Vacuum_Sel_1 "Living Room"
Switch Vacuum_Sel_2 "Kitchen"
Switch Vacuum_Sel_3 "Hallway"
Number Vacuum_RoomTimes "Repeats [%d]"
Switch Vacuum_StartRooms "Clean selected rooms"
Switch Vacuum_ClearRooms "Clear selection"

// ---- Optional: Amazon Alexa (vacuum cleaner device type) ----
// Not linked to a channel: the rules in movavacuum.rules translate between the Alexa mode and the command channel.
String Vacuum_AlexaMode "Vacuum" <vacuum> {
    alexa="VacuumCleaner.Mode" [
        capabilityNames="@Setting.Mode",
        supportedModes="CLEAN=@Setting.Clean,DOCK=@Setting.Dock,PAUSE=@Setting.Pause,STOP=@Setting.Stop",
        actionMappings="Resume=CLEAN,Pause=PAUSE,Stop=STOP,TurnOn=CLEAN,TurnOff=DOCK"
    ]
}
