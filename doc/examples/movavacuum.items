// Example items for the Mova/Dreame Vacuum Binding (all channels).
// Replace "home" (bridge id) and "vacuum" (thing id) with your own UIDs, and remove what you do not need.

String Vacuum_State "State [%s]" <vacuum> { channel="movavacuum:vacuum:home:vacuum:state" }
Number:Dimensionless Vacuum_Battery "Battery [%d %%]" <battery> { channel="movavacuum:vacuum:home:vacuum:battery" }
Switch Vacuum_Charging "Charging" <energy> { channel="movavacuum:vacuum:home:vacuum:charging" }
